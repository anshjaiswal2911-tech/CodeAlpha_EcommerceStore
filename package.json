{
  "name": "codealpha-ecommerce-store",
  "version": "1.0.0",
  "description": "CodeAlpha Full Stack Development Internship - Task 1: Simple E-Commerce Store",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
